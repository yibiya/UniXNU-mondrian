--- /dev/null
+++ b/bsd/dev/k60_metal.c
@@ -0,0 +1,164 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Deploy the generated Metal bundle only after the writable Data mount is verified. */
+#include <sys/types.h>
+#include <sys/vnode.h>
+#include <sys/uio.h>
+#include <sys/fcntl.h>
+#include <sys/sysproto.h>
+#include <sys/kauth.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/errno.h>
+
+extern const unsigned char k60_metal_blob[];
+extern const unsigned long long k60_metal_blob_len;
+extern const unsigned short k60_metal_blob_modes[];
+
+#define K60_METAL_ROOT "/private/var/ngpu"
+#define K60_METAL_FILES 6
+#define K60_METAL_TABLE_END (8 + K60_METAL_FILES * 10)
+
+static uint16_t
+k60_metal_le16(const unsigned char *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+static uint32_t
+k60_metal_le32(const unsigned char *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* Recover only empty root-owned regular files left by the old O_CREAT bug.
+ * Never unlink a directory, symlink, nonempty file or another owner's object. */
+static int
+k60_metal_mkdir(proc_t p, user_addr_t scratch, const char *path, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (!error) {
+		if (vnode_isdir(vp)) {
+			vnode_put(vp);
+			return 0;
+		}
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_uid);
+		VATTR_WANTED(&va, va_data_size);
+		int regular = vnode_isreg(vp);
+		error = vnode_getattr(vp, &va, ctx);
+		vnode_put(vp);
+		if (error) return error;
+		if (!regular || !VATTR_IS_SUPPORTED(&va, va_uid) ||
+		    !VATTR_IS_SUPPORTED(&va, va_data_size) || va.va_uid || va.va_data_size) {
+			printf("K60METAL refuse non-directory %s\n", path);
+			return ENOTDIR;
+		}
+		struct unlink_args remove = {.path = scratch + 0xc00};
+		int32_t result = 0;
+		error = copyout(path, remove.path, strlen(path) + 1);
+		if (!error) error = unlink(p, &remove, &result);
+		printf("K60METAL remove empty legacy file %s error=%d\n", path, error);
+		if (error) return error;
+	} else if (error != ENOENT) {
+		return error;
+	}
+	struct mkdir_args request = {.path = scratch + 0xc00, .mode = 0755};
+	int32_t result = 0;
+	error = copyout(path, request.path, strlen(path) + 1);
+	if (!error) error = mkdir(p, &request, &result);
+	if (error) return error;
+	error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (!error) {
+		if (!vnode_isdir(vp)) error = ENOTDIR;
+		vnode_put(vp);
+	}
+	return error;
+}
+
+static int
+k60_metal_write(proc_t p, vfs_context_t ctx, const char *path,
+    const unsigned char *bytes, uint32_t size, mode_t mode)
+{
+	vnode_t vp = NULLVP;
+	int resid = 0;
+	int error = vnode_open(path, O_CREAT | O_WRONLY | O_TRUNC | O_NOFOLLOW,
+	    mode, 0, &vp, ctx);
+	if (error) return error;
+	if (!vnode_isreg(vp)) {
+		error = EINVAL;
+	} else {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+		VATTR_SET(&va, va_mode, mode);
+		error = vnode_setattr(vp, &va, ctx);
+		if (!error) error = vn_rdwr(UIO_WRITE, vp, (caddr_t)bytes,
+		    size, 0, UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(ctx), &resid, p);
+		if (!error && resid) error = EIO;
+	}
+	int close_error = vnode_close(vp, O_WRONLY, ctx);
+	return error ? error : close_error;
+}
+
+int
+k60_metal_deploy(proc_t p, user_addr_t scratch)
+{
+	const unsigned char *blob = k60_metal_blob;
+	uint32_t index;
+	size_t names_end = K60_METAL_TABLE_END;
+	int error = 0, written = 0;
+	vfs_context_t ctx = vfs_context_current();
+	if (k60_metal_blob_len < K60_METAL_TABLE_END ||
+	    k60_metal_le32(blob) != 0x4d30364b ||
+	    k60_metal_le32(blob + 4) != K60_METAL_FILES) return EINVAL;
+	/* Validate the entire name table and body bounds before touching Data. */
+	for (index = 0; index < K60_METAL_FILES; index++) {
+		const unsigned char *entry = blob + 8 + index * 10;
+		uint16_t length = k60_metal_le16(entry);
+		if (!length || length >= 200 || names_end > k60_metal_blob_len ||
+		    length > k60_metal_blob_len - names_end) return EINVAL;
+		names_end += length;
+	}
+	for (index = 0; index < K60_METAL_FILES; index++) {
+		const unsigned char *entry = blob + 8 + index * 10;
+		uint32_t size = k60_metal_le32(entry + 2), offset = k60_metal_le32(entry + 6);
+		if (offset < names_end || offset > k60_metal_blob_len ||
+		    size > k60_metal_blob_len - offset) return EINVAL;
+	}
+	static const char *const directories[] = {
+		K60_METAL_ROOT, K60_METAL_ROOT "/addons",
+		K60_METAL_ROOT "/addons/PongAdrenoMetal.bundle"
+	};
+	for (index = 0; index < sizeof(directories) / sizeof(directories[0]); index++) {
+		error = k60_metal_mkdir(p, scratch, directories[index], ctx);
+		printf("K60METAL mkdir %s error=%d\n", directories[index], error);
+		if (error) goto done;
+	}
+	/* A failed rewrite must not leave publication enabled for a partial bundle. */
+	error = k60_metal_write(p, ctx, K60_METAL_ROOT "/addons/PongAdrenoMetal.publish",
+	    (const unsigned char *)"0\n", 2, 0644);
+	if (error) goto done;
+	size_t name_offset = K60_METAL_TABLE_END;
+	for (index = 0; index < K60_METAL_FILES; index++) {
+		const unsigned char *entry = blob + 8 + index * 10;
+		uint16_t length = k60_metal_le16(entry);
+		uint32_t size = k60_metal_le32(entry + 2), offset = k60_metal_le32(entry + 6);
+		char path[256];
+		size_t prefix = sizeof(K60_METAL_ROOT "/") - 1;
+		memcpy(path, K60_METAL_ROOT "/", prefix);
+		memcpy(path + prefix, blob + name_offset, length);
+		path[prefix + length] = '\0';
+		name_offset += length;
+		error = k60_metal_write(p, ctx, path, blob + offset, size, k60_metal_blob_modes[index]);
+		printf("K60METAL write file=%u bytes=%u error=%d\n", index, size, error);
+		if (error) break;
+		written++;
+	}
+ done:
+	printf("K60METAL deploy files=%d/%u error=%d\n", written, K60_METAL_FILES, error);
+	return error;
+}
